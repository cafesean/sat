generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String            @unique
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  role               UserRole          @default(USER)
  gradeLevel         Int?
  languagePreference String            @default("en")
  hashedPassword     String?
  accounts           Account[]
  answerAttempts     AnswerAttempt[]
  practiceSessions   PracticeSession[]
  sessions           Session[]
  WordBank           WordBank[]
  createdGroups      Group[]          @relation("CreatedGroups")
  groupMemberships   GroupMember[]
  sharedWordBanks    SharedWordBank[] @relation("SharedBy")
  receivedSharedWordBanks SharedWordBank[] @relation("SharedWithUser")
  invitesSent        GroupInvite[]    @relation("InvitedBy")
  invitesReceived    GroupInvite[]    @relation("InvitedUser")
  notifications      Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WordMaster {
  id               String   @id @default(cuid())
  baseWord         String
  variations       Json
  language         String   @default("en")
  wordType         String?
  definition       String?
  sampleSentences  Json
  translations     Json
  isDictionaryWord Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  words            Word[]

  @@unique([baseWord, language])
}

model WordBankWords {
  id         String   @id @default(cuid())
  wordBankId String
  words      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  wordBank   WordBank @relation(fields: [wordBankId], references: [id], onDelete: Cascade)
}

model Word {
  id                   String            @id @default(cuid())
  wordBankId           String
  interval             Int               @default(1)
  easeFactor           Float             @default(2.5)
  repetitions          Int               @default(0)
  nextReviewDate       DateTime          @default(now())
  isStarred            Boolean           @default(false)
  notes                String?
  wordMasterId         String
  text                 String            @default("")
  mastery              Int               @default(0)
  nextDueAtReviewCount Int               @default(0)
  timesSeen            Int               @default(0)
  successRate          Float             @default(0)
  wordBank             WordBank          @relation(fields: [wordBankId], references: [id], onDelete: Cascade)
  wordMaster           WordMaster        @relation(fields: [wordMasterId], references: [id], onDelete: Cascade)
  practiceLogs         WordPracticeLog[]

  @@unique([wordBankId, wordMasterId])
}

model WordPracticeLog {
  id                String          @id @default(cuid())
  wordId            String
  practiceSessionId String
  timestamp         DateTime        @default(now())
  userSentence      String
  isCorrect         Boolean
  aiFeedback        String?
  easeChosen        Int
  hintUsed          Boolean         @default(false)
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  word              Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model PracticeSession {
  id             String            @id @default(cuid())
  userId         String
  type           PracticeType
  startTime      DateTime          @default(now())
  endTime        DateTime?
  score          Float?
  difficulty     Int?
  createdAt      DateTime          @default(now())
  wordBankId     String?
  answerAttempts AnswerAttempt[]
  passage        Passage?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordBank       WordBank?         @relation(fields: [wordBankId], references: [id])
  vocabLogs      WordPracticeLog[]
}

model Passage {
  id                String          @id @default(cuid())
  content           String
  difficulty        Int
  createdAt         DateTime        @default(now())
  practiceSessionId String          @unique
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  questions         Question[]
}

model Question {
  id             String          @id @default(cuid())
  passageId      String
  questionText   String
  type           QuestionType    @default(MULTIPLE_CHOICE)
  options        String[]
  correctAnswer  String
  explanation    String?
  createdAt      DateTime        @default(now())
  answerAttempts AnswerAttempt[]
  passage        Passage         @relation(fields: [passageId], references: [id], onDelete: Cascade)
}

model AnswerAttempt {
  id                String          @id @default(cuid())
  practiceSessionId String
  questionId        String
  userId            String
  selectedAnswer    String
  isCorrect         Boolean
  timestamp         DateTime        @default(now())
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WordBank {
  id               String            @id @default(cuid())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  reviewCount      Int               @default(0) // Added reviewCount
  practiceSessions PracticeSession[]
  words            Word[]
  User             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordReferences   WordBankWords[]
  sharedWordBanks  SharedWordBank[] // Added for SharedWordBank.wordBank
}

model Group {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  creatorId String
  creator   User         @relation("CreatedGroups", fields: [creatorId], references: [id]) // Added relation name
  members   GroupMember[]
  sharedWordBanks SharedWordBank[] @relation("GroupSharedWordBanks") // Added relation name
  invites   GroupInvite[] @relation("GroupInvites") // Removed fields and references from this side of the relation
}

model GroupMember {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())
  role      String   @default("member") // e.g., 'admin', 'member'
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model SharedWordBank {
  id              String    @id @default(cuid())
  wordBankId      String
  sharedById      String
  sharedWithGroupId String?
  sharedWithUserId  String?
  sharedAt        DateTime  @default(now())
  shareLink       String?   @unique
  wordBank        WordBank  @relation(fields: [wordBankId], references: [id], onDelete: Cascade)
  sharedBy        User      @relation("SharedBy", fields: [sharedById], references: [id])
  sharedWithGroup Group?    @relation("GroupSharedWordBanks", fields: [sharedWithGroupId], references: [id], onDelete: Cascade) // Added relation name
  sharedWithUser  User?     @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([wordBankId, sharedWithGroupId])
  @@unique([wordBankId, sharedWithUserId])
}

model GroupInvite {
  id              String   @id @default(cuid())
  groupId         String
  invitedByUserId String
  invitedUserId   String?  // Optional, if known (email invite)
  inviteToken     String   @unique
  status          String   @default("pending") // pending, accepted, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group           Group    @relation("GroupInvites", fields: [groupId], references: [id], onDelete: Cascade)
  invitedByUser   User     @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  invitedUser     User?    @relation("InvitedUser", fields: [invitedUserId], references: [id])

  @@unique([groupId, invitedUserId])
}

model Notification {
  id          String      @id @default(cuid())
  userId      String
  type        NotificationType
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  readAt      DateTime?
  metadata    Json?
  
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
}

enum NotificationType {
  MEMBER_JOINED
  WORD_BANK_SHARED
  GROUP_INVITE
  GENERAL
}

enum UserRole {
  USER
  ADMIN
}

enum PracticeType {
  VOCABULARY
  READING_WRITING
}

enum QuestionType {
  MULTIPLE_CHOICE
}
