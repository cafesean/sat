generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                @id @default(cuid())
  name                       String?
  email                      String                @unique
  emailVerified              DateTime?
  image                      String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  role                       UserRole              @default(USER)
  gradeLevel                 Int?
  languagePreference         String                @default("en")
  hashedPassword             String?
  accounts                   Account[]
  answerAttempts             AnswerAttempt[]
  practiceSessions           PracticeSession[]
  sessions                   Session[]
  WordBank                   WordBank[]
  createdGroups              Group[]               @relation("CreatedGroups")
  groupMemberships           GroupMember[]
  sharedWordBanks            SharedWordBank[]      @relation("SharedBy")
  receivedSharedWordBanks    SharedWordBank[]      @relation("SharedWithUser")
  invitesSent                GroupInvite[]         @relation("InvitedBy")
  invitesReceived            GroupInvite[]         @relation("InvitedUser")
  notifications              Notification[]
  questionSets               QuestionSet[]         @relation("CreatedQuestionSets")
  sharedQuestionSets         SharedQuestionSet[]   @relation("SharedQuestionSetsBy")
  receivedSharedQuestionSets SharedQuestionSet[]   @relation("SharedQuestionSetsWith")
  questionChats              QuestionChat[]
  practiceSessionChats       PracticeSessionChat[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model WordBank {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  userId           String
  name             String
  updatedAt        DateTime          @updatedAt
  description      String?
  isPublic         Boolean           @default(false)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  words            Word[]
  practiceSessions PracticeSession[]
  sharedWith       SharedWordBank[]
  groups           GroupWordBank[]
}

model Word {
  id           String            @id @default(cuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  wordBankId   String
  wordMasterId String
  isStarred    Boolean           @default(false)
  wordType     String?
  notes        String?
  text         String
  wordBank     WordBank          @relation(fields: [wordBankId], references: [id], onDelete: Cascade)
  wordMaster   WordMaster        @relation(fields: [wordMasterId], references: [id])
  practiceLogs WordPracticeLog[]

  // SRS fields
  interval             Int       @default(1)
  easeFactor           Float     @default(2.5)
  repetitions          Int       @default(0)
  mastery              Int       @default(0)
  timesSeen            Int       @default(0)
  successRate          Float     @default(0)
  nextReviewDate       DateTime?
  nextDueAtReviewCount Int?
  reviewCount          Int       @default(0)
  userSentences        String[]

  @@unique([wordBankId, wordMasterId])
}

model WordMaster {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sampleSentences  String[]
  baseWord         String
  variations       Json
  language         String
  wordType         String?
  definition       String?
  translations     Json
  isDictionaryWord Boolean  @default(false)
  words            Word[]
}

model PracticeSession {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  userId            String
  type              PracticeType
  startTime         DateTime              @default(now())
  endTime           DateTime?
  score             Int?
  difficulty        Int?
  wordBankId        String?
  lastFetchedWordId String?
  questionSetId     String?
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordBank          WordBank?             @relation(fields: [wordBankId], references: [id])
  questionSet       QuestionSet?          @relation(fields: [questionSetId], references: [id])
  vocabLogs         WordPracticeLog[]
  passage           Passage?
  answerAttempts    AnswerAttempt[]
  chats             PracticeSessionChat[]
}

model WordPracticeLog {
  id                String          @id @default(cuid())
  practiceSessionId String
  wordId            String
  isCorrect         Boolean
  timestamp         DateTime        @default(now())
  userSentences     String[]
  aiFeedback        String?
  easeChosen        Int
  hintUsed          Boolean         @default(false)
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  word              Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)
}

model Group {
  id              String           @id @default(cuid())
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  creatorId       String
  isPublic        Boolean          @default(false)
  creator         User             @relation("CreatedGroups", fields: [creatorId], references: [id])
  members         GroupMember[]
  wordBanks       GroupWordBank[]
  sharedWordBanks SharedWordBank[] @relation("GroupSharedWordBanks")
  invites         GroupInvite[]    @relation("GroupInvites")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // member, admin
  joinedAt DateTime @default(now())
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model GroupWordBank {
  id         String   @id @default(cuid())
  groupId    String
  wordBankId String
  addedAt    DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  wordBank   WordBank @relation(fields: [wordBankId], references: [id], onDelete: Cascade)

  @@unique([groupId, wordBankId])
}

model SharedWordBank {
  id                String   @id @default(cuid())
  wordBankId        String
  sharedById        String
  sharedWithGroupId String?
  sharedWithUserId  String?
  sharedAt          DateTime @default(now())
  shareLink         String?  @unique
  wordBank          WordBank @relation(fields: [wordBankId], references: [id], onDelete: Cascade)
  sharedBy          User     @relation("SharedBy", fields: [sharedById], references: [id])
  sharedWithGroup   Group?   @relation("GroupSharedWordBanks", fields: [sharedWithGroupId], references: [id], onDelete: Cascade) // Added relation name
  sharedWithUser    User?    @relation("SharedWithUser", fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([wordBankId, sharedWithGroupId])
  @@unique([wordBankId, sharedWithUserId])
}

model GroupInvite {
  id              String   @id @default(cuid())
  groupId         String
  invitedByUserId String
  invitedUserId   String? // Optional, if known (email invite)
  inviteToken     String   @unique
  status          String   @default("pending") // pending, accepted, rejected
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  group         Group @relation("GroupInvites", fields: [groupId], references: [id], onDelete: Cascade)
  invitedByUser User  @relation("InvitedBy", fields: [invitedByUserId], references: [id])
  invitedUser   User? @relation("InvitedUser", fields: [invitedUserId], references: [id])

  @@unique([groupId, invitedUserId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?
  metadata  Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

enum NotificationType {
  MEMBER_JOINED
  WORD_BANK_SHARED
  GROUP_INVITE
  GENERAL
}

enum UserRole {
  USER
  ADMIN
}

enum PracticeType {
  VOCABULARY
  READING_WRITING
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

model QuestionSet {
  id               String              @id @default(uuid())
  topic            String
  userId           String
  createdAt        DateTime            @default(now())
  user             User                @relation("CreatedQuestionSets", fields: [userId], references: [id], onDelete: Cascade)
  passages         Passage[]
  sharedWith       SharedQuestionSet[]
  practiceSessions PracticeSession[]
}

model Passage {
  id                String           @id @default(uuid())
  content           String
  difficulty        Int
  practiceSessionId String?          @unique
  questionSetId     String?
  createdAt         DateTime         @default(now())
  practiceSession   PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  questionSet       QuestionSet?     @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  questions         Question[]
}

model Question {
  id             String          @id @default(uuid())
  passageId      String
  questionText   String
  questionType   QuestionType    @default(MULTIPLE_CHOICE)
  options        String[]
  correctAnswer  String
  explanation    String?
  createdAt      DateTime        @default(now())
  passage        Passage         @relation(fields: [passageId], references: [id], onDelete: Cascade)
  answerAttempts AnswerAttempt[]
  chats          QuestionChat[]
}

model AnswerAttempt {
  id                String          @id @default(uuid())
  practiceSessionId String
  questionId        String
  userId            String
  selectedAnswer    String
  isCorrect         Boolean
  createdAt         DateTime        @default(now())
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SharedQuestionSet {
  id                String      @id @default(uuid())
  questionSetId     String
  sharedById        String
  sharedWithUserId  String?
  sharedWithGroupId String?
  shareLink         String?     @unique
  sharedAt          DateTime    @default(now())
  questionSet       QuestionSet @relation(fields: [questionSetId], references: [id], onDelete: Cascade)
  sharedBy          User        @relation("SharedQuestionSetsBy", fields: [sharedById], references: [id])
  sharedWithUser    User?       @relation("SharedQuestionSetsWith", fields: [sharedWithUserId], references: [id], onDelete: Cascade)
}

model QuestionChat {
  id         String   @id @default(uuid())
  questionId String
  userId     String
  message    String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PracticeSessionChat {
  id                String          @id @default(uuid())
  practiceSessionId String
  userId            String
  message           String
  isBot             Boolean         @default(false)
  createdAt         DateTime        @default(now())
  practiceSession   PracticeSession @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}
